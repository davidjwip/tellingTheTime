{
  "name": "telling-the-time",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Supervised clock-reading practice for a four-year-old",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "validate:levels": "vite-node scripts/validate-levels.ts",
    "gate:tests-first": "vite-node scripts/check-test-first.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "npm run typecheck && npm run validate:levels && npm run test:coverage && npm run gate:tests-first"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^1.6.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  }
}
